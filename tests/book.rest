@host=http://localhost
@port=4444
@server={{host}}:{{port}}

### Összes könyv
GET {{server}}/api/books

### Könyv módosítása ID alapján
PATCH {{server}}/api/books/1
Content-Type: application/json

{
    "title": "proba",
    "author": "aron",
    "category": "programozas",
    "published_year": 2026
}

### Új könyv hozzáadása
PUT {{server}}/api/books/1
Content-Type: application/json

{
    "title": "Programozas alapjai",
    "author": "Aron",
    "category": "programozas",
    "published_year": 2026
}

### Könyv adatainak módosítása ID alapján
PATCH {{server}}/api/books/1
Content-Type: application/json

{
    "title": "Proba konyv",
    "author": "Aron",
    "category": "programozas",
    "published_year": 2026
}

### Könyv törlése ID alapján
DELETE {{server}}/api/books/1
